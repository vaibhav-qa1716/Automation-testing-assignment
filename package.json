{
  "name": "stackguard-qa-assignment",
  "version": "1.0.0",
  "private": true,
  "description": "QA Engineer assignment: Sauce Demo UI and Restful-Booker API automation",
  "scripts": {
    "test": "playwright test",
    "test:ui": "playwright test tests/ui",
    "test:api": "playwright test tests/api",
    "test:headed": "playwright test --headed",
    "test:debug": "playwright test --debug",
    "report": "playwright show-report",
    "typecheck": "tsc --noEmit",
    "diagnose:ui": "node scripts/diagnose-ui.cjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@types/node": "^22.0.0",
    "typescript": "^5.9.0"
  }
}
